# ─── Required ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram supergroup chat ID (the forum group Reach listens in).
# Obtain via: forward a message from the group to @userinfobot
TELEGRAM_CHAT_ID=

# ─── Optional ────────────────────────────────────────────────────────────────

# LLM model to use. Default: claude-sonnet-4
# REACH_MODEL=claude-sonnet-4

# Tool approval policy. Default: approveAll
# Options: approveAll, denyAll, interactiveDestructive
# REACH_PERMISSION_POLICY=approveAll

# ─── Idle Backoff ─────────────────────────────────────────────────────────────

# How long (ms) before a session is considered idle. Default: 300000 (5 min)
# IDLE_TIMEOUT_MS=300000

# ─── Teams transport (REACH_CHANNEL=teams) ────────────────────────────────────
#
# Set REACH_CHANNEL=teams and fill in the five vars below to use Microsoft Teams
# instead of Telegram. All five are required when REACH_CHANNEL=teams.
#
# Auth: client-credentials flow (OAuth2). Register an Azure AD app with:
#   Permissions: Chat.ReadWrite, ChannelMessage.Send, ChannelMessage.Read.All
#   Admin consent required (one-time, see Phase 2 setup guide).
#
# REACH_CHANNEL=teams

# Azure AD tenant ID (Directory ID in portal.azure.com → Azure Active Directory).
# TEAMS_TENANT_ID=

# Azure AD application (client) ID for the registered app.
# TEAMS_CLIENT_ID=

# Azure AD client secret (generated under Certificates & secrets for the app).
# TEAMS_CLIENT_SECRET=

# Microsoft Teams team ID (GUID). Found via Graph Explorer:
#   GET https://graph.microsoft.com/v1.0/teams
# TEAMS_TEAM_ID=

# Teams channel ID within the team. Found via:
#   GET https://graph.microsoft.com/v1.0/teams/{team-id}/channels
# TEAMS_CHANNEL_ID=
